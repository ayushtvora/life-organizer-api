# Copy to .env for local `docker compose up`. In production the deploy workflow writes .env from GitHub Secrets.

# Shared secret the iPhone Shortcut sends as X-API-Key (generate with: openssl rand -hex 32)
App__ApiKey=
# IANA timezone used to resolve "tomorrow", "5pm", etc.
App__TimeZone=America/Toronto
App__DefaultEventMinutes=60

# Claude API key for the LLM fallback. Leave empty to use rules only.
Anthropic__ApiKey=
Anthropic__Model=claude-haiku-5-5

# base64 of the service account key JSON, and the calendar shared with it (usually your Gmail address)
Google__ServiceAccountJsonBase64=
Google__CalendarId=

Todoist__ApiToken=
# Optional; empty = Inbox
Todoist__ProjectId=

# true = parse and reply without creating anything
Integrations__DryRun=false

# Used by docker-compose.yml, not the app
API_PORT=8080
CLOUDFLARE_TUNNEL_TOKEN=
